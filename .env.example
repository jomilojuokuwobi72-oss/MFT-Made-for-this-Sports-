# Copy these into your .env and fill with real values.

# Public site origin — used for SEO metadata, OG images, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://www.mft-sports.com

# Supabase — required for the waitlist + contact forms to actually store data.
# Without these, the forms run in "simulation mode" (fake success, nothing saved).
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
